# BugBattle (Miss Information Platform) - Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Authentication (NextAuth.js)
# ============================================
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-here-change-in-production-min-32-chars

# ============================================
# Database Configuration
# ============================================
# For development: using LowDB (file-based, no config needed)
# For production: uncomment and configure your database
# DATABASE_URL=postgresql://user:password@localhost:5432/bugbattle
# DATABASE_URL=mongodb://localhost:27017/bugbattle

# ============================================
# AI API Keys
# ============================================

# XAI (Grok) - Used for content analysis and sentiment detection
# Get your key at: https://x.ai/api
XAI_API_KEY=your-xai-grok-api-key-here

# Tavus AI - Used for expert video generation
# Get your key at: https://tavus.io
TAVUS_API_KEY=your-tavus-api-key-here

# OpenAI (Alternative to XAI)
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# Data Source APIs
# ============================================

# Wikipedia API (Optional - public API, no key required by default)
# For higher rate limits, get key at: https://meta.wikimedia.org/wiki/API
WIKIPEDIA_API_KEY=

# RSS Feed Configuration
RSS_REFRESH_INTERVAL=300000
# Refresh interval in milliseconds (default: 5 minutes)

# ============================================
# Security Configuration
# ============================================

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
# Window in milliseconds (default: 1 minute)

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Comma-separated list of allowed origins

# Session Settings
SESSION_MAX_AGE=86400
# Session duration in seconds (default: 24 hours)

# ============================================
# Feature Flags
# ============================================

# Enable/disable features
ENABLE_LEADERBOARD=true
ENABLE_AI_EXPERTS=true
ENABLE_RSS_MONITORING=true
ENABLE_WIKIPEDIA_VERIFICATION=true
ENABLE_REAL_TIME_ALERTS=true

# Demo Mode (for testing/presentations)
DEMO_MODE=false
MOCK_EXTERNAL_APIS=false
DISABLE_RATE_LIMITING=false

# ============================================
# Logging and Monitoring
# ============================================

# Log Level: error, warn, info, debug
LOG_LEVEL=info

# Enable detailed error logging
DEBUG_MODE=false

# Sentry (Error Tracking) - Optional
# Get your DSN at: https://sentry.io
# SENTRY_DSN=your-sentry-dsn-here

# ============================================
# Email Configuration (Optional)
# ============================================

# SMTP settings for notifications
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@example.com
# EMAIL_PASSWORD=your-email-password
# EMAIL_FROM=noreply@yourdomain.com

# ============================================
# Storage Configuration (Optional)
# ============================================

# For production deployments with file uploads
# AWS S3
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=bugbattle-uploads

# Google Cloud Storage
# GCS_PROJECT_ID=your-project-id
# GCS_BUCKET=bugbattle-uploads
# GCS_KEY_FILE=path/to/keyfile.json

# ============================================
# Analytics (Optional)
# ============================================

# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# ============================================
# Payment Integration (Optional)
# ============================================

# Stripe - For premium features (DO NOT commit real keys!)
# Get your keys at: https://dashboard.stripe.com/apikeys
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ============================================
# Development Tools
# ============================================

# Next.js Development
NEXT_TELEMETRY_DISABLED=1

# TypeScript
# TS_NODE_DEV=true

# ============================================
# Production Deployment
# ============================================

# Vercel
# Automatically set by Vercel, no need to configure
# VERCEL_URL=your-deployment-url.vercel.app

# Docker
# PORT=3000
# HOST=0.0.0.0

# ============================================
# Notes
# ============================================

# IMPORTANT SECURITY NOTES:
# 1. NEVER commit this file with real API keys to version control
# 2. Use .env.local for local development (git-ignored)
# 3. Use environment variables in production (Vercel, Docker, etc.)
# 4. Rotate API keys regularly (every 90 days recommended)
# 5. Use different keys for development and production
# 6. Keep NEXTAUTH_SECRET secure and unique per environment

# API Key Security:
# - Store keys in environment variables, never in code
# - Use key management services (AWS Secrets Manager, etc.) in production
# - Implement key rotation policies
# - Monitor API usage for anomalies
# - Use minimal permissions for each API key

# Getting Started:
# 1. cp .env.example .env.local
# 2. Fill in required values (at minimum: NEXTAUTH_SECRET)
# 3. Optional: Add API keys for AI features
# 4. npm run dev
# 5. Open http://localhost:3000

# Required for Basic Functionality:
# - NEXTAUTH_SECRET (generate with: openssl rand -base64 32)
# - NEXTAUTH_URL (usually http://localhost:3000 for dev)

# Required for Full Features:
# - XAI_API_KEY or OPENAI_API_KEY (for AI analysis)
# - TAVUS_API_KEY (for expert video generation)

# For more information, see: docs/SETUP.md
